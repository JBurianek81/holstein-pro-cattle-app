rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Farm data - users can only access their own farm data
    match /farmData/{farmCode} {
      allow read, write: if request.auth != null && 
        request.auth.token.email in resource.data.members;
    }
    
    // Tasks - users can read/write tasks they're assigned to or created
    match /tasks/{taskId} {
      allow read, write: if request.auth != null &&
        (resource.data.assignedTo == request.auth.token.email ||
         resource.data.createdBy == request.auth.token.email ||
         resource.data.farmCode == request.auth.token.farmCode);
    }
    
    // Users - users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == userId;
    }
    
    // Farms - users can read farm info if they're a member
    match /farms/{farmCode} {
      allow read: if request.auth != null && 
        request.auth.token.email in resource.data.members;
      allow write: if request.auth != null && 
        request.auth.token.email == resource.data.ownerEmail;
    }
    
    // TEMPORARY: Allow all access for testing (remove this in production)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}